__pycache__/
*.bin
*.wav
.venv/

# Secrets — never commit
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.p12
*.pfx
*_api_key*
*_secret*
credentials.json
secrets/

# Agent workspace
.claude/
.mcp.json
.corpus/

