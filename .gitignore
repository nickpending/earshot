docs/work/*/journal.jsonl
docs/work/*/.journal.checksum
docs/work/*/results/
docs/work/*/shape/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Earshot.app (SwiftPM build products and the signed bundle)
.build/
dist/
.swiftpm/
